<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>StoneMaster.Corel</RootNamespace>
    <AssemblyName>StoneMaster.Corel</AssemblyName>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <!-- Supplied by the licensed CorelDRAW installation; never stored here. -->
    <CorelInteropPath Condition="'$(CorelInteropPath)' == ''">$(COREL_VGCORE_INTEROP)</CorelInteropPath>
  </PropertyGroup>
  <Target Name="ValidateCorelInterop" BeforeTargets="ResolveReferences">
    <Error Condition="'$(CorelInteropPath)' == '' Or !Exists('$(CorelInteropPath)')"
           Text="Corel.Interop.VGCore.dll was not found. Set CorelInteropPath or COREL_VGCORE_INTEROP to the DLL from the installed, licensed CorelDRAW SDK." />
  </Target>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Corel.Interop.VGCore">
      <HintPath>$(CorelInteropPath)</HintPath>
      <Private>false</Private>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </Reference>
  </ItemGroup>
</Project>

<UserControl x:Class="StoneMaster.Corel.Docker.StoneDocker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock Text="StoneMaster" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Rhinestone &amp; Trok Designer" Margin="0,0,0,12"/>
            <Button Content="AYRI PENCEREDE AÇ" Click="OpenFloatingWindow_Click" Margin="0,0,0,8"/>

            <GroupBox Header="GÖRSEL" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <Button x:Name="btnUseSelected" Content="📷 CorelDRAW'da Seçili Görseli Kullan" Click="UseSelected_Click" FontWeight="Bold"/>
                    <TextBlock Text="veya" Margin="0,4,0,4" FontStyle="Italic" Foreground="Gray"/>
                    <Button Content="📁 Dosyadan Görsel Aç" Click="SelectImage_Click"/>
                    <TextBlock Text="Aktif Görsel:" Margin="0,8,0,4" FontWeight="Bold"/>
                    <Border BorderBrush="LightGray" BorderThickness="1" Padding="4" Background="#F5F5F5">
                        <TextBlock x:Name="txtImage" Text="Henüz görsel seçilmedi" TextWrapping="Wrap"/>
                    </Border>
                    <Button Content="🚫 Taşsız Bölge Seç" Click="ExcludeSelectedArea_Click" Margin="0,6,0,0" ToolTip="CorelDRAW'da bir alan seçip bu butona tıklayın"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="⚙️ HIZLI AYARLAR" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <TextBlock Text="Hazır Modlar:" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cmbMode" SelectedIndex="0" ToolTip="Yerleştirme modunu seçin">
                        <ComboBoxItem ToolTip="Tam doldurma - tüm deseni taşlarla kapla">FULL - Tam Doldurma</ComboBoxItem>
                        <ComboBoxItem ToolTip="Sadece kenarları vurgula">EDGE - Sadece Kenar</ComboBoxItem>
                        <ComboBoxItem ToolTip="Desenin içini doldur">FILL - İç Doldurma</ComboBoxItem>
                        <ComboBoxItem ToolTip="Dağınık/serpme yerleştirme">SCATTER - Serpme</ComboBoxItem>
                        <ComboBoxItem ToolTip="Bütçeye göre optimizasyon">BUDGET - Bütçe Modu</ComboBoxItem>
                    </ComboBox>
                    
                    <CheckBox x:Name="chkEdgeOnly" Content="✏️ Sadece Kenarlara Taş Diz" Margin="0,8,0,4" ToolTip="Kenar algılama sonrası sadece kenar çizgilerine taş yerleştirir"/>
                    <CheckBox x:Name="chkSprinkle" Content="✨ Serpme Modu (Yumuşak Geçişler)" Margin="0,4,0,0" ToolTip="Daha doğal, dağınık görünüm için"/>
                    <CheckBox x:Name="chkGridSnap" Content="🔲 Grid Hizalama (Satır/Sütun)" Margin="0,4,0,0" ToolTip="Taşları düzenli satır ve sütunlara hizalar"/>
                    <Button Content="🎯 İnteraktif Alan Seçimi" Click="InteractiveSelect_Click" Margin="0,6,0,0" ToolTip="Önizlemede tıklayarak alan seçin"/>
                    <TextBlock x:Name="txtSelectionMode" Text="" Margin="0,4,0,0" FontStyle="Italic" Foreground="Green" FontWeight="Bold"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="📏 KALIP / ÇALIŞMA ALANI" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <TextBlock Text="Kalıp Boyutu (Standart Çalışma Alanı):" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cmbTemplateSize" SelectedIndex="0" ToolTip="Standart kalıp boyutlarını seçin">
                        <ComboBoxItem Tag="500,700">50x70 cm (Standart)</ComboBoxItem>
                        <ComboBoxItem Tag="700,500">70x50 cm (Yatay)</ComboBoxItem>
                        <ComboBoxItem Tag="600,800">60x80 cm (Büyük)</ComboBoxItem>
                        <ComboBoxItem Tag="800,600">80x60 cm (Geniş)</ComboBoxItem>
                        <ComboBoxItem Tag="1000,1000">100x100 cm (Kare)</ComboBoxItem>
                        <ComboBoxItem Tag="custom">Özel Ölçü</ComboBoxItem>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Genişlik (mm):" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtWidth" Text="500" Width="80" ToolTip="Çalışma alanı genişliği (mm)"/>
                        <TextBlock Text="Yükseklik (mm):" Margin="12,0,8,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtHeight" Text="700" Width="80" ToolTip="Çalışma alanı yüksekliği (mm)"/>
                    </StackPanel>
                    <TextBlock Text="Görsel otomatik olarak kalıba ölçeklenecek" Margin="0,6,0,0" FontStyle="Italic" Foreground="Gray" FontSize="11"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="💎 TAŞ SEÇİMİ" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <TextBlock Text="Taş Boyutları (en az birini seçin):" FontWeight="Bold" Margin="0,0,0,4"/>
                    <Border BorderBrush="LightGray" BorderThickness="1" Padding="4">
                        <ListBox x:Name="cmbStoneSizes" Height="100" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBoxItem><CheckBox Content="SS6 (2.0mm)" IsChecked="False"/></ListBoxItem>
                            <ListBoxItem><CheckBox Content="SS8 (2.5mm)" IsChecked="False"/></ListBoxItem>
                            <ListBoxItem><CheckBox Content="SS10 (3.0mm) ✓" IsChecked="True"/></ListBoxItem>
                            <ListBoxItem><CheckBox Content="SS12 (3.5mm)" IsChecked="False"/></ListBoxItem>
                            <ListBoxItem><CheckBox Content="SS16 (4.0mm)" IsChecked="False"/></ListBoxItem>
                            <ListBoxItem><CheckBox Content="SS20 (5.0mm)" IsChecked="False"/></ListBoxItem>
                            <ListBoxItem><CheckBox Content="SS30 (6.5mm)" IsChecked="False"/></ListBoxItem>
                            <ListBoxItem><CheckBox Content="SS34 (7.5mm)" IsChecked="False"/></ListBoxItem>
                        </ListBox>
                    </Border>
                    
                    <TextBlock Text="Renk Paleti (çoklu seçim):" FontWeight="Bold" Margin="0,8,0,4"/>
                    <Border BorderBrush="LightGray" BorderThickness="1" Padding="4">
                        <ListBox x:Name="cmbPalette" Height="120" SelectionMode="Multiple">
                            <ListBoxItem><CheckBox Content="Crystal (Şeffaf)" IsChecked="True"/></ListBoxItem>
                            <ListBoxItem><CheckBox Content="Black (Siyah)" IsChecked="True"/></ListBoxItem>
                            <ListBoxItem><CheckBox Content="Red (Kırmızı)" IsChecked="True"/></ListBoxItem>
                            <ListBoxItem><CheckBox Content="Blue (Mavi)" IsChecked="True"/></ListBoxItem>
                            <ListBoxItem><CheckBox Content="Green (Yeşil)" IsChecked="True"/></ListBoxItem>
                            <ListBoxItem><CheckBox Content="Gold (Altın)" IsChecked="False"/></ListBoxItem>
                            <ListBoxItem><CheckBox Content="Silver (Gümüş)" IsChecked="False"/></ListBoxItem>
                            <ListBoxItem><CheckBox Content="Pink (Pembe)" IsChecked="False"/></ListBoxItem>
                        </ListBox>
                    </Border>
                    
                    <Button Content="🎨 Fotoğraftan Renk Ekle" Click="SampleColor_Click" Margin="0,6,0,0" ToolTip="Önizlemede bir noktaya tıklayarak renk ekleyin"/>
                    <Button Content="🚫 Hariç Tutulacak Renk Seç" Click="ExcludeColor_Click" Margin="0,4,0,0" ToolTip="Önizlemede istemediğiniz rengi seçin"/>
                    
                    <TextBlock Text="Taş Arası Boşluk (Gap - mm)" FontWeight="Bold" Margin="0,8,0,2"/>
                    <TextBox x:Name="txtGap" Text="0.50" ToolTip="Taşlar arasındaki minimum boşluk"/>
                    
                    <TextBlock Text="Lazer Toleransı (mm)" FontWeight="Bold" Margin="0,6,0,2"/>
                    <TextBox x:Name="txtLaser" Text="0.30" ToolTip="Lazer kalıp için tolerans değeri"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="🌫️ ARKA PLAN TEMİZLEME" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <TextBlock Text="Arka Plan Modu:" FontWeight="Bold" Margin="0,0,0,2"/>
                    <ComboBox x:Name="cmbBackgroundMode" SelectedIndex="0" ToolTip="Arka plan algılama modu">
                        <ComboBoxItem ToolTip="Açık renkleri arka plan olarak algıla">LIGHT - Açık Renkleri Temizle</ComboBoxItem>
                        <ComboBoxItem ToolTip="Otomatik algılama">AUTO - Otomatik</ComboBoxItem>
                        <ComboBoxItem ToolTip="Koyu renkleri arka plan olarak algıla">DARK - Koyu Renkleri Temizle</ComboBoxItem>
                        <ComboBoxItem ToolTip="Belirli bir rengi temizle">COLOR - Özel Renk</ComboBoxItem>
                    </ComboBox>
                    <Button Content="🎨 Arka Plan Rengini Seç" Click="SelectBackgroundColor_Click" Margin="0,6,0,0"/>
                    <TextBlock x:Name="txtBackgroundColor" Text="#F5F5F5" Margin="0,4,0,0" FontWeight="Bold"/>
                    <TextBlock Text="Tolerans Değeri (daha yüksek = daha fazla alan temizlenir)" Margin="0,6,0,2"/>
                    <TextBox x:Name="txtBackgroundTolerance" Text="28"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="YOĞUNLUK / DETAY" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <TextBlock Text="🎯 Yoğunluk ve Detay Ayarları" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="Taş Yoğunluğu" Margin="0,4,0,2"/>
                    <Slider x:Name="sldDensity" Minimum="0.1" Maximum="1" Value="0.65" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                    <TextBlock Text="Kenar Algılama Hassasiyeti" Margin="0,6,0,2"/>
                    <Slider x:Name="sldEdge" Minimum="0" Maximum="1" Value="0.5" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                    <TextBlock Text="Detay Algılama Hassasiyeti" Margin="0,6,0,2"/>
                    <Slider x:Name="sldDetail" Minimum="0" Maximum="1" Value="0.5" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                    <TextBlock Text="Arka Plan Temizleme Eşiği" Margin="0,6,0,2"/>
                    <Slider x:Name="sldBg" Minimum="0" Maximum="255" Value="245"/>
                </StackPanel>
            </GroupBox>

            <CheckBox x:Name="chkLivePreview" Content="🔄 Canlı Önizleme (ayar değişince güncelle)" Margin="12,0,12,8"/>

            <GroupBox Header="BÜTÇE" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <TextBlock Text="💰 Bütçe Kontrolü" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="Hedef Bütçe (TL)" Margin="0,4,0,2"/>
                    <TextBox x:Name="txtBudget" Text="200"/>
                    <TextBlock Text="Özel birim taş maliyeti (TL, opsiyonel)" Margin="0,6,0,2"/>
                    <TextBox x:Name="txtStoneUnitPrice"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="🖼️ ÖNİZLEME" Margin="0,0,0,8">
                <Border BorderBrush="LightGray" BorderThickness="1" Background="White" Height="240">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="PreviewSurface" Width="380" Height="220" RenderTransformOrigin="0.5,0.5">
                            <Image x:Name="PreviewImage" Stretch="Fill" Opacity="0.35"/>
                            <Canvas x:Name="PreviewCanvas" Width="380" Height="220" Background="Transparent" MouseLeftButtonDown="PreviewCanvas_MouseLeftButtonDown"/>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </GroupBox>
            <TextBlock x:Name="txtStoneCount" Text="🔢 Taş sayısı: 0" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
            <TextBlock x:Name="txtCost" Text="💰 Tahmini maliyet: 0.00 TL" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <CheckBox x:Name="chkShowBackground" Content="🖼️ Arka plan fotoğrafını göster" IsChecked="True" Click="BackgroundVisibility_Click" VerticalAlignment="Center"/>
                <TextBlock Text="🔍 Zoom" Margin="12,0,4,0" VerticalAlignment="Center"/>
                <Slider x:Name="sldZoom" Minimum="0.5" Maximum="3" Value="1" Width="140" ValueChanged="Zoom_ValueChanged"/>
            </StackPanel>
            
            <Button Content="🗑️ Seçili taşları sil" Click="DeleteSelectedStones_Click" Margin="0,0,0,8" Background="#FFE0E0"/>

            <GroupBox Header="⚡ İŞLEM" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="▶️ ÖNİZLEME OLUŞTUR" Click="Preview_Click" Margin="0,0,6,0" Padding="15,8" FontWeight="Bold" Background="#E0F0FF"/>
                        <Button Content="✅ CORELDRAW'A AKTAR" Click="Apply_Click" Padding="15,8" FontWeight="Bold" Background="#E0FFE0"/>
                    </StackPanel>
                    <CheckBox x:Name="chkApplySelectedOnly" Content="Sadece seçili boyut ve renkleri aktar" Margin="0,0,0,4"/>
                    <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Height="20" Margin="0,4,0,4"/>
                    <TextBlock x:Name="txtProgress" Text="Hazır" Margin="0,0,0,4" FontStyle="Italic"/>
                    <Button Content="❌ İPTAL" Click="Cancel_Click" Margin="0,4,0,0"/>
                </StackPanel>
            </GroupBox>
            
            <Border BorderBrush="LightBlue" BorderThickness="1" Padding="8" Background="#F0F8FF" CornerRadius="4">
                <TextBlock x:Name="txtStatus" Margin="0" TextWrapping="Wrap" FontWeight="Bold">
                    <Run Text="👋 Hoşgeldiniz! Başlamak için bir görsel seçin ve Önizleme Oluştur'a tıklayın."/>
                </TextBlock>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

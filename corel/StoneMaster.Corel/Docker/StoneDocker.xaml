<UserControl x:Class="StoneMaster.Corel.Docker.StoneDocker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock Text="StoneMaster" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Rhinestone &amp; Trok Designer" Margin="0,0,0,12"/>
            <Button Content="AYRI PENCEREDE AÇ" Click="OpenFloatingWindow_Click" Margin="0,0,0,8"/>

            <GroupBox Header="GÖRSEL" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <Button x:Name="btnUseSelected" Content="Seçili / Aktif Bitmap Kullan" Click="UseSelected_Click"/>
                    <Button Content="Önizlemede taşsız grup seç" Click="ExcludeSelectedArea_Click" Margin="0,6,0,0"/>
                    <TextBlock Text="Aktif Görsel:" Margin="0,8,0,0"/>
                    <TextBlock x:Name="txtImage" Text="Seçilmedi" TextWrapping="Wrap"/>
                    <Button Content="Görsel Seç" Click="SelectImage_Click" Margin="0,6,0,0"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="ÖLÇEK" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <TextBlock Text="Kumaş Genişliği (mm)"/>
                    <TextBox x:Name="txtWidth" Text="1000"/>
                    <TextBlock Text="Kumaş Yüksekliği (opsiyonel)" Margin="0,6,0,0"/>
                    <TextBox x:Name="txtHeight"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="TAŞ" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <TextBlock Text="Kullanılacak taş boyutları (tikleyin)"/>
                    <ListBox x:Name="cmbStoneSizes" Height="90">
                        <ListBoxItem><CheckBox Content="SS6" IsChecked="False"/></ListBoxItem><ListBoxItem><CheckBox Content="SS8" IsChecked="False"/></ListBoxItem>
                        <ListBoxItem><CheckBox Content="SS10" IsChecked="True"/></ListBoxItem><ListBoxItem><CheckBox Content="SS12" IsChecked="False"/></ListBoxItem>
                        <ListBoxItem><CheckBox Content="SS16" IsChecked="False"/></ListBoxItem><ListBoxItem><CheckBox Content="SS20" IsChecked="False"/></ListBoxItem>
                        <ListBoxItem><CheckBox Content="SS30" IsChecked="False"/></ListBoxItem><ListBoxItem><CheckBox Content="SS34" IsChecked="False"/></ListBoxItem>
                    </ListBox>
                    <TextBlock Text="Renk paleti (Ctrl ile çoklu seç)" Margin="0,6,0,0"/>
                    <ListBox x:Name="cmbPalette" Height="110">
                        <ListBoxItem><CheckBox Content="Crystal" IsChecked="True"/></ListBoxItem><ListBoxItem><CheckBox Content="Black" IsChecked="True"/></ListBoxItem>
                        <ListBoxItem><CheckBox Content="Red" IsChecked="True"/></ListBoxItem><ListBoxItem><CheckBox Content="Blue" IsChecked="True"/></ListBoxItem>
                        <ListBoxItem><CheckBox Content="Green" IsChecked="True"/></ListBoxItem><ListBoxItem><CheckBox Content="Gold" IsChecked="False"/></ListBoxItem>
                        <ListBoxItem><CheckBox Content="Silver" IsChecked="False"/></ListBoxItem><ListBoxItem><CheckBox Content="Pink" IsChecked="False"/></ListBoxItem>
                    </ListBox>
                    <Button Content="Fotoğraftan seçili rengi ekle" Click="SampleColor_Click" Margin="0,6,0,0"/>
                    <Button Content="Fotoğraftan hariç tutulacak rengi seç" Click="ExcludeColor_Click" Margin="0,4,0,0"/>
                    <TextBlock Text="Gap (mm)" Margin="0,6,0,0"/>
                    <TextBox x:Name="txtGap" Text="0.50"/>
                    <TextBlock Text="Lazer Toleransı (mm)" Margin="0,6,0,0"/>
                    <TextBox x:Name="txtLaser" Text="0.30"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="ARKA PLAN" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <TextBlock Text="Taşa dönüşmeyecek arka plan"/>
                    <ComboBox x:Name="cmbBackgroundMode" SelectedIndex="0">
                        <ComboBoxItem>LIGHT</ComboBoxItem>
                        <ComboBoxItem>AUTO</ComboBoxItem>
                        <ComboBoxItem>DARK</ComboBoxItem>
                        <ComboBoxItem>COLOR</ComboBoxItem>
                    </ComboBox>
                    <Button Content="Taşa dönüşmeyecek arka plan rengini seç" Click="SelectBackgroundColor_Click" Margin="0,6,0,0"/>
                    <TextBlock x:Name="txtBackgroundColor" Text="#F5F5F5" Margin="0,4,0,0"/>
                    <TextBlock Text="Otomatik arka plan toleransı" Margin="0,6,0,0"/>
                    <TextBox x:Name="txtBackgroundTolerance" Text="28"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="YOĞUNLUK / DETAY" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <Button Content="Kenarları otomatik seç" Click="SelectEdges_Click"/>
                    <CheckBox x:Name="chkEdgeOnly" Content="Sadece seçilen kenarlara taş diz" Margin="0,6,0,0"/>
                    <TextBlock Text="Kenar eşiği" Margin="0,6,0,0"/>
                    <Slider x:Name="sldEdgeThreshold" Minimum="0" Maximum="255" Value="80"/>
                    <TextBlock Text="Yoğunluk"/>
                    <Slider x:Name="sldDensity" Minimum="0.1" Maximum="1" Value="0.65"/>
                    <TextBlock Text="Kenar Hassasiyeti"/>
                    <Slider x:Name="sldEdge" Minimum="0" Maximum="1" Value="0.5"/>
                    <TextBlock Text="Detay Hassasiyeti"/>
                    <Slider x:Name="sldDetail" Minimum="0" Maximum="1" Value="0.5"/>
                    <TextBlock Text="Arka Plan Eşiği"/>
                    <Slider x:Name="sldBg" Minimum="0" Maximum="255" Value="245"/>
                </StackPanel>
            </GroupBox>

            <CheckBox x:Name="chkSprinkle" Content="Serpme dizim (yumuşak desenler için)" Margin="12,0,12,8"/>
            <CheckBox x:Name="chkLivePreview" Content="Ayar değişince önizlemeyi güncelle" Margin="12,0,12,8"/>

            <GroupBox Header="BÜTÇE" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <ComboBox x:Name="cmbMode" SelectedIndex="0">
                        <ComboBoxItem>FULL</ComboBoxItem>
                        <ComboBoxItem>REPORT</ComboBoxItem>
                        <ComboBoxItem>BUDGET</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="Hedef Bütçe (TL)" Margin="0,6,0,0"/>
                    <TextBox x:Name="txtBudget" Text="200"/>
                    <TextBlock Text="Özel birim taş maliyeti (TL, opsiyonel)" Margin="0,6,0,0"/>
                    <TextBox x:Name="txtStoneUnitPrice"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="ÖNİZLEME" Margin="0,0,0,8">
                <Border BorderBrush="Gray" BorderThickness="1" Background="White" Height="220">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="PreviewSurface" Width="360" Height="200" RenderTransformOrigin="0.5,0.5">
                            <Image x:Name="PreviewImage" Stretch="Fill" Opacity="0.35"/>
                            <Canvas x:Name="PreviewCanvas" Width="360" Height="200" Background="Transparent" MouseLeftButtonDown="PreviewCanvas_MouseLeftButtonDown"/>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </GroupBox>
            <TextBlock x:Name="txtStoneCount" Text="Taş sayısı: 0" FontWeight="Bold" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <CheckBox x:Name="chkShowBackground" Content="Fotoğrafı göster" IsChecked="True" Click="BackgroundVisibility_Click" VerticalAlignment="Center"/>
                <TextBlock Text="Zoom" Margin="12,0,4,0" VerticalAlignment="Center"/>
                <Slider x:Name="sldZoom" Minimum="0.5" Maximum="3" Value="1" Width="140" ValueChanged="Zoom_ValueChanged"/>
            </StackPanel>
            <Button Content="Seçili taşları sil" Click="DeleteSelectedStones_Click" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal">
                <Button Content="ÖNİZLEME" Click="Preview_Click" Margin="0,0,6,0"/>
                <Button Content="CORELDRAW'A UYGULA" Click="Apply_Click"/>
            </StackPanel>
            <CheckBox x:Name="chkApplySelectedOnly" Content="Sadece seçili boyut ve renkleri Corel'e aktar" Margin="0,8,0,0"/>
            <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Height="16" Margin="0,8,0,0"/>
            <TextBlock x:Name="txtProgress" Text="Hazır" Margin="0,4,0,0"/>
            <Button Content="İPTAL" Click="Cancel_Click" Margin="0,6,0,0"/>
            <TextBlock x:Name="txtStatus" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
